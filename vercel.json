{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "includeFiles": "dist/**",
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
