# Copy to .env for local development. NEVER commit .env or put real secrets in this file.
# Every value below that contains "change-me" is a placeholder: replace it before use.
# Node 22.9+ loads .env automatically through the npm scripts (--env-file-if-exists).

NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed by CORS (exact match, no wildcards).
CORS_ORIGINS=http://localhost:5173

# Checkout is simulated. "simulated" is the only supported value; anything else stops the app at startup.
PAYMENTS_MODE=simulated

# --- Database (local MongoDB from docker-compose.yml) -------------------------------------------
# Password for the local MongoDB container. Pick any long random value for your own machine.
MONGO_ROOT_PASSWORD=change-me-local-mongo-password
# Must use the same password as above. If it contains special characters, URL-encode them.
MONGODB_URI=mongodb://nestapp:change-me-local-mongo-password@127.0.0.1:27017/nestapp?authSource=admin

# --- Authentication -----------------------------------------------------------------------------
# Signs access tokens. At least 32 characters; generate one with: openssl rand -base64 48
# Required whenever MONGODB_URI is set. Production refuses a value containing "change-me".
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# Access token lifetime in seconds (60 to 86400). Default 900 (15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900

# --- Seed accounts (read only by `npm run seed`) -------------------------------------------------
# The private owner/admin account. Use your own address and a strong password; never commit them.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# Shared password of the synthetic demo-customer@example.com and demo-viewer@example.com accounts.
# These accounts only hold synthetic data, but still use a different value from the admin password.
SEED_DEMO_PASSWORD=change-me-demo-password

# --- Tests that need a real MongoDB (`npm run test:db`) ------------------------------------------
# Use a throwaway database name: its users collection is emptied by the tests.
# MONGODB_TEST_URI=mongodb://nestapp:change-me-local-mongo-password@127.0.0.1:27017/nestapp_test?authSource=admin
