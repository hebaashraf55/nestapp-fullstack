# Copy to .env for local development. NEVER commit .env or put real secrets in this file.
# Only variables that the code currently reads are listed. More are added as features land.

NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed by CORS (exact match, no wildcards).
CORS_ORIGINS=http://localhost:5173

# Checkout is simulated. "simulated" is the only supported value; anything else stops the app at startup.
PAYMENTS_MODE=simulated
